{
  // Cloudflare Workers static site: serves this folder as assets.
  // Deploy with `npx wrangler deploy` (or connect the repo in the Cloudflare dashboard).
  "name": "cat-prep",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  }
}
